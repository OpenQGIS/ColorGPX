[flake8]
# max-line-length: relaxed to 120 to accommodate QGIS API call chains,
# datetime format strings, and f-string expressions that cannot be
# meaningfully split without hurting readability.
max-line-length = 120

# E501 is already covered by max-line-length above.
# W503: line break before binary operator (conflicts with W504; PEP 8
#        now recommends W504 style, so we suppress W503).
extend-ignore = W503

# Exclude generated/vendor files and QGIS auto-generated resource files.
exclude =
    __pycache__,
    .git,
    *.egg-info
