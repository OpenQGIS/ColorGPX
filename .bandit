[bandit]
# B405: xml.etree.ElementTree import
#   Rationale: defusedxml is used as the primary parser (try/import).
#   The stdlib fallback is only reached if defusedxml is not installed,
#   which is acceptable for a QGIS plugin environment. Each call site
#   is also individually suppressed with # nosec B405.
#
# B314: xml.etree.ElementTree.parse / iterparse
#   Rationale: All GPX files are user-selected local files, not remote
#   untrusted input. defusedxml is preferred; stdlib fallback is guarded.
#   Each call site is individually suppressed with # nosec B314.
#
# B110: try_except_pass
#   Rationale: The single occurrence in _check_gpx_has_data() intentionally
#   swallows file-read errors to provide a graceful no-op when the source
#   GPX file is temporarily inaccessible (e.g. network drive disconnect).
#   The suppression is also marked inline with # nosec B110.
skips = B405,B314,B110
